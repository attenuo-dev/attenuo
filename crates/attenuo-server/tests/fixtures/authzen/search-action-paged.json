{
  "_note": "AuthZEN 1.0 section 8 (Action Search API) and 8.2 (pagination). The resource is the MCP server; the candidates are the catalog's github tools in name order (create_issue, delete_repo, pay, read_file). page.limit 2 evaluates two candidates per page: the first page keeps create_issue (delete_repo needs an approval, which a search never has) and returns a non-empty next_token; sent back as page.token, the second page keeps pay (read_file needs context.input.repo) and ends with next_token \"\". Each result carries properties.server, so it can be sent as the action of POST /access/v1/evaluation unchanged, and the last step shows that evaluation with the same subject, resource and context decides it true. X-Request-ID is echoed (10.1.3).",
  "token": {},
  "steps": [
    {
      "path": "/access/v1/search/action",
      "body": {
        "subject": {
          "type": "agent",
          "id": ""
        },
        "resource": {
          "type": "mcp_server",
          "id": "github"
        },
        "page": {
          "limit": 2
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "page": {
            "next_token": "AQQBAAAAAAAAAAI",
            "count": 1
          },
          "results": [
            {
              "name": "create_issue",
              "properties": {
                "server": "github"
              }
            }
          ]
        },
        "headers": {
          "x-request-id": "search-1"
        }
      },
      "headers": {
        "x-request-id": "search-1"
      }
    },
    {
      "path": "/access/v1/search/action",
      "body": {
        "subject": {
          "type": "agent",
          "id": ""
        },
        "resource": {
          "type": "mcp_server",
          "id": "github"
        },
        "page": {
          "limit": 2,
          "token": "AQQBAAAAAAAAAAI"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "page": {
            "next_token": "",
            "count": 1
          },
          "results": [
            {
              "name": "pay",
              "properties": {
                "server": "github"
              }
            }
          ]
        }
      }
    },
    {
      "path": "/access/v1/evaluation",
      "body": {
        "subject": {
          "type": "agent",
          "id": ""
        },
        "action": {
          "name": "pay",
          "properties": {
            "server": "github"
          }
        },
        "resource": {
          "type": "mcp_server",
          "id": "github"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "decision": true,
          "context": {
            "reason": "policy_allow",
            "policy_ids": [
              "payments"
            ],
            "diagnostics": [],
            "decision_id": "<decision_id>"
          }
        }
      }
    }
  ]
}
