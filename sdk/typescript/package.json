{
  "name": "@onbehalf/sdk",
  "version": "0.0.0",
  "description": "TypeScript client for the onbehalf authorization server: token exchange, attenuated capabilities, MCP calls through the enforcing proxy, lease renewal and the audit log.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "ONBEHALF_INTEGRATION=1 vitest run test/integration.test.ts",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "keywords": [
    "onbehalf",
    "mcp",
    "agents",
    "authorization",
    "delegation",
    "rfc8693"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  }
}
